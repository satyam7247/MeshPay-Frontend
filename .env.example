# Use the deployed HTTPS backend URL. For local Android development, use your
# computer's LAN IP and http://; Expo config enables Android cleartext only then.
EXPO_PUBLIC_API_URL=https://your-api.example.com
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id
# Development-only fallback. It is not a sandbox UPI address and may open a real payment app.
EXPO_PUBLIC_DEMO_MERCHANT_UPI_ID=merchant@upi
