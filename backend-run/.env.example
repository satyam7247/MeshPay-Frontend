# Copy to .env and replace placeholders only for services you enable.
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:h2:mem:upimesh;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
DB_USERNAME=sa
DB_PASSWORD=replace_with_database_password
DB_DDL_AUTO=update
SPRING_FLYWAY_LOCATIONS=classpath:db/migration/{vendor}
TEST_DB_URL=jdbc:mysql://localhost:3306/upimesh_test?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
TEST_DB_USERNAME=replace_with_test_database_username
TEST_DB_PASSWORD=replace_with_test_database_password
BREVO_API_KEY=replace_with_brevo_api_key
BREVO_SENDER_EMAIL=replace_with_verified_sender_email
BREVO_SENDER_NAME=MeshPay
SMS_PROVIDER=none
BANK_LINK_OTP_PROVIDER=none
ACCOUNT_DELETION_OTP_PROVIDER=none
TWILIO_ACCOUNT_SID=replace_with_twilio_account_sid
TWILIO_AUTH_TOKEN=replace_with_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=replace_with_twilio_verify_service_sid
ALLOW_EMAIL_BANK_LINK_OTP=false
ALLOW_EMAIL_ACCOUNT_DELETION_OTP=false
APP_ENVIRONMENT=development
# Set true only for the local mesh simulator; seeds four demo ledger accounts.
UPI_MESH_DEMO_SEED=false
# Enable only in a trusted local demo; exposes mutable simulator endpoints.
UPI_MESH_DEMO_ENDPOINTS_ENABLED=false
BANK_LINK_OTP_HMAC_SECRET=replace_with_a_random_secret_of_at_least_32_bytes

# Cashfree Secure ID bank verification
BANK_VERIFICATION_PROVIDER=none
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_CLIENT_ID=replace_with_cashfree_client_id
CASHFREE_CLIENT_SECRET=replace_with_cashfree_client_secret
BANK_DATA_ENCRYPTION_KEY=replace_with_base64_encoded_32_byte_aes_key
RAZORPAY_WEBHOOK_SECRET=replace_with_razorpay_webhook_secret
# Comma-separated socket IPs allowed to provide X-Forwarded-For for rate-limit attribution.
APP_SECURITY_TRUSTED_PROXY_ADDRESSES=
# Backward-compatible alias; prefer APP_SECURITY_TRUSTED_PROXY_ADDRESSES.
TRUSTED_PROXY_ADDRESSES=
APP_LOCK_IDLE_TIMEOUT_SECONDS=300
